<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5209980">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <BuildCommand>npm run build</BuildCommand>
    <!-- Skip ng build on every VS Build; use Build when you want production output -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>
</Project>
